# Copy to .env.local and fill in. Values here are placeholders, never secrets:
# .env.example is committed, .env.local is not.

# PostHog — Project settings → Project ID / Web analytics.
# `phc_…` is the *public* project token: it ships in the client bundle by
# design, so it is not a secret. It does, however, decide which project the
# events land in — point local development at a separate throwaway project,
# or your own clicks and session replays end up mixed into production data.
#
# Region matters: this project is on EU Cloud, which the /ingest rewrite in
# next.config.mjs already hardcodes. A token from a US project will silently
# fail against those EU hosts.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
